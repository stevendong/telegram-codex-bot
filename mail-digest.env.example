# Install separately as /etc/mail-digest.env, mode 0600; never commit real keys.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace_me
TELEGRAM_BOT_TOKEN=replace_me
MAIL_DIGEST_CHAT_ID=123456789
MAIL_DIGEST_CODEX_BIN=/home/ubuntu/.nvm/versions/node/v24.21.0/bin/codex
MAIL_DIGEST_AUTH_HOME=/home/ubuntu/.codex
MAIL_DIGEST_STATE_DIR=/var/lib/mail-digest
MAIL_DIGEST_TIMEZONE=Asia/Shanghai
MAIL_DIGEST_BATCH_SIZE=25
MAIL_DIGEST_CODEX_TIMEOUT=240
# Empty uses Codex's available default model.
MAIL_DIGEST_MODEL=
