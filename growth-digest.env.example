# Inherits /etc/mail-digest.env; install separately as /etc/growth-digest.env, root 0600.
GROWTH_DIGEST_STATE_DIR=/var/lib/growth-digest
GROWTH_DIGEST_TIMEZONE=Asia/Shanghai
GROWTH_DIGEST_MODEL=
# A dedicated latest-report page containing the two generated-section markers.
GROWTH_DIGEST_NOTION_PAGE_ID=replace_with_report_page_uuid
