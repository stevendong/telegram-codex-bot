# 从 @BotFather 获取。不要提交真实 Token。
TELEGRAM_BOT_TOKEN=replace_me

# 只允许这些 Telegram 数字用户 ID，多个 ID 用逗号分隔。
TELEGRAM_ALLOWED_USER_IDS=123456789

# Codex 在后台统一从该目录启动；Telegram 不按项目切换。
CODEX_CWD=/data
CODEX_BIN=/home/ubuntu/.nvm/versions/node/v23.11.1/bin/codex
# 等同于 codex --yolo：不启用 Codex 沙盒，也不请求审批。
CODEX_SANDBOX=danger-full-access
CODEX_ALLOW_DANGER_FULL_ACCESS=true

# 每个名称对应一套独立的 Codex 登录目录；Telegram 用名称切换账号。
CODEX_ACCOUNTS=default=/home/ubuntu/.codex,account4=/home/ubuntu/.codex-account-4,agentopt=/home/ubuntu/.codex-agent-opt
CODEX_DEFAULT_ACCOUNT=default

# 留空则使用当前 Codex 默认模型。
CODEX_MODEL=

CODEX_BOT_STATE_FILE=/var/lib/telegram-codex-bot/state.json
CODEX_TURN_TIMEOUT_SECONDS=3600
CODEX_MAX_PARALLEL_TURNS=4
TELEGRAM_POLL_TIMEOUT_SECONDS=45
